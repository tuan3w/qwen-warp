+// confidence of draft j (cf index j-1): raw softmax max-prob of the restricted-head logits (= 1 / sum exp(l - max)); cf[8 + j-1] = max prob of the processed proposal q (sampling) or the same value (greedy)
+__global__ void __launch_bounds__(1024) k_conf(const float* __restrict__ lg, int n, int j, const Dist* __restrict__ q, float* __restrict__ cf) {
+  __shared__ float red[32];
+  const int t = threadIdx.x;
+  float m = -3.0e38f;
+  for (int i = t; i < n; i += 1024) m = fmaxf(m, lg[i]);
+  m = warp_max(m);
+  if ((t & 31) == 0) red[t >> 5] = m;
+  __syncthreads();
+  if (t < 32) {
+    float v = red[t];
+    v = warp_max(v);
+    if (t == 0) red[0] = v;
+  }
+  __syncthreads();
+  const float M = red[0];
+  __syncthreads();
+  float sum = 0.f;
+  for (int i = t; i < n; i += 1024) sum += __expf(lg[i] - M);
+  sum = warp_sum(sum);
+  if ((t & 31) == 0) red[t >> 5] = sum;
+  __syncthreads();
+  if (t == 0) {
+    float tot = 0.f;
+    for (int i = 0; i < 32; i++) tot += red[i];
+    cf[j] = 1.0f / tot;
+    cf[8 + j] = q ? q->p[0] : 1.0f / tot;
+  }
