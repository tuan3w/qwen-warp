+// Timing parts of the deep cycle graphs (async replays; state evolves, cost is state independent).  Needs an engine with tmax = 8.
+cudaError_t smk_spec_deep_launch(smk_spec* s, int kc, int kv, int which, int n, cudaStream_t st) {
+  if (kc < 1 || kc > SMK_DEEP_KC || kv < 0 || kv > SMK_DEEP_KC || kv + 1 > s->e->tmax || which < 0 || which > 3) return cudaErrorInvalidValue;
+  sync_epoch(s);
+  const bool samp = s->samp;
+  for (int i = 0; i < n; i++) CKS(smk_graph_launch(s->e, &s->g_deep[samp][which][kc][kv], [&](cudaStream_t c) { return deep_part(s, kc, kv, which, samp, c); }, st));
+  return cudaSuccess;
+}
