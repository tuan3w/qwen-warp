+    s->dlog_i.insert(s->dlog_i.end(), {0, nch, ln, nd, kcn, prio, 0, 0});
+    CKS(smk_graph_launch(e, &s->g_deep[samp][0][kcn][kv], [&](cudaStream_t c) { return deep_part(s, kcn, kv, 0, samp, c); }, st));
+    const long long t1 = now_ns();
+    const int want = ++s->dp_seq;
+    uint64_t spins = 0;
+    while (s->dres->seq != want) {
+      _mm_pause();
+      if ((++spins & 0xfffff) == 0) {
+        const cudaError_t q = cudaStreamQuery(st);
+        if (q != cudaSuccess && q != cudaErrorNotReady) return q;
+        if (now_ns() - t1 > 30000000000LL) return cudaErrorLaunchTimeout;
+      }
+    }
+    std::atomic_thread_fence(std::memory_order_acquire);
+    const long long t2 = now_ns();
+    const int a = s->dres->a;
+    int y[8];
+    for (int j = 0; j < 8; j++) y[j] = s->dres->y[j];
+    for (int j = 0; j < SMK_DEEP_KC; j++) s->dp_d[j] = s->dres->d[j];
+    for (int j = 0; j < 16; j++) s->dp_conf[j] = s->dres->conf[j];
+    s->dp_nd = kcn;
+    s->dlog_i[li] = a;
+    s->dp_ema = 0.6f * s->dp_ema + 0.4f * (float)((a - 1) < nch ? (a - 1) : nch);
+    if (s->pld) smk_pld_append(s->pld, y, a);
+    s->dp_stat[0] += t2 - t1;
+    s->dp_stat[1] += (t1 - t0) + (now_ns() - t2);
+  }
+  CKS(cudaMemcpyAsync(s->pinned_ss, s->ss, SS_N * sizeof(int), cudaMemcpyDeviceToHost, st));
+  CKS(cudaMemcpyAsync(s->pinned_ring, s->ring, RING * sizeof(int), cudaMemcpyDeviceToHost, st));
+  CKS(cudaStreamSynchronize(st));
+  memcpy(host_ss, s->pinned_ss, SS_N * sizeof(int));
+  memcpy(host_ring, s->pinned_ring, RING * sizeof(int));
+  return cudaSuccess;
+}
+
+// Cycle log since smk_spec_deep_begin: ints [n][8] = a, nch, ln, nd, kc_next, tail-priority flag, 0, 0; floats [n][16] = the confidences of the drafts the cycle used.  Returns n (<= cap); clear = 1 empties the log.
+int smk_spec_deep_log(smk_spec* s, int* oi, float* of, int cap, int clear) {
+  const int n = (int)(s->dlog_i.size() / 8);
+  const int m = n < cap ? n : cap;
+  memcpy(oi, s->dlog_i.data(), (size_t)m * 8 * sizeof(int));
+  memcpy(of, s->dlog_f.data(), (size_t)m * 16 * sizeof(float));
+  if (clear) { s->dlog_i.clear(); s->dlog_f.clear(); }
+  return m;
+}
+// host seconds: out[0] = wait for the GPU result (ns), out[1] = host proposer + launch work (ns)
+cudaError_t smk_spec_deep_stats(smk_spec* s, long long* out) { out[0] = s->dp_stat[0]; out[1] = s->dp_stat[1]; return cudaSuccess; }
+
