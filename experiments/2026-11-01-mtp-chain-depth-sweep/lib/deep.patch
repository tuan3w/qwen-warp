+// verify width kv (T = kv + 1 rows: anchor, nch chain drafts, kv - nch tail tokens), accept, MTP catch-up of kv + 1 rows, kc chain drafts (+ confidence), mailbox report
+static cudaError_t deep_verify_accept(smk_spec* s, int kv, bool samp, cudaStream_t c) {
+  smk_engine* e = s->e;
+  CKS(smk_run_step(e, 1 + kv, 1, 1, c, samp));
+  if (!samp) {
+    k_accept<<<1, 1, 0, c>>>(e->ds, s->ss, s->ring, kv);
+    return cudaGetLastError();
+  }
+  CKS(sk_topk(e->logits, 1 + kv, VOC, VOC, nullptr, s->sp, 0, s->ws_t, s->pd, c));
+  if (kv > 0) { k_delta_q_dev<<<kv, SK_KMAX, 0, c>>>(e->ds + DS_TOK + 1, s->qd, s->nch_dev); CKS(cudaGetLastError()); }
+  return sk_accept(e->ds, s->ss, s->ring, kv, s->pd, s->qd, s->sp, c);
+}
+// which: 0 full cycle, 1 verify + accept, 2 MTP stage (catch-up kv + 1 rows + kc drafts + conf), 3 full cycle without the confidence kernels' mailbox report
+static cudaError_t deep_part(smk_spec* s, int kc, int kv, int which, bool samp, cudaStream_t c) {
+  switch (which) {
+    case 0:
+      CKS(deep_verify_accept(s, kv, samp, c));
+      CKS(mtp_stage(s, kv + 1, kc, false, samp, c, true));
+      k_deep_report<<<1, 32, 0, c>>>(s->e->ds, s->ss, s->cf, s->dres_dev);
+      return cudaGetLastError();
+    case 1: return deep_verify_accept(s, kv, samp, c);
+    case 2: return mtp_stage(s, kv + 1, kc, false, samp, c, true);
+    case 3:
+      CKS(deep_verify_accept(s, kv, samp, c));
+      return mtp_stage(s, kv + 1, kc, false, samp, c, false);
+  }
+  return cudaErrorInvalidValue;
+}
