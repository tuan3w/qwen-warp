# Copy to .env to change the defaults of docker-compose.yml.
# MODEL_DIR=/path/to/swift-1.5-int4      # default: $HOME/models/swift-1.5-int4
# PORT=8000
# PROFILE=long                           # long (4-bit KV cache, 196,608 context) or default (bf16 KV, 20,480 context)
# EXTRA_ARGS=--max-model-len 262144 --prompt-lookup 0     # full 262,144-token context
